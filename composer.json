{
	"name": "pronamic/wp-orbis-organizations",
	"description": "The Orbis Organizations plugin extends your Orbis environment with the option to manage organizations.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"orbis",
		"organizations",
		"wordpress",
		"plugin"
	],
	"homepage": "https://www.pronamic.eu/orbis/",
	"autoload": {
		"psr-4": {
			"Pronamic\\Orbis\\Organizations\\": "psr-4/"
		}
	},
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu",
			"homepage": "https://www.pronamic.eu/",
			"role": "Developer"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "https://www.remcotolsma.nl/",
			"role": "Developer"
		},
		{
			"name": "Karel-Jan Tolsma",
			"email": "info@kareljantolsma.nl",
			"homepage": "https://www.kareljantolsma.nl/",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@pronamic.eu",
		"issues": "https://github.com/pronamic/wp-orbis-organizations/issues",
		"source": "https://github.com/pronamic/wp-orbis-organizations"
	},
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"platform-check": false,
		"sort-packages": true
	},
	"require": {
		"php": "^8.3",
		"automattic/jetpack-autoloader": "^6.0",
		"composer/installers": "^2.3"
	},
	"require-dev": {
		"deployer/deployer": "^7.5",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"pronamic/wp-coding-standards": "^2.5",
		"rector/rector": "^2.6",
		"roots/wordpress-no-content": "^7.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"wp-plugin/posts-to-posts": "^1.7"
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"vendor:pronamic",
				"vendor:solvebeam",
				"vendor:wp-pay",
				"woocommerce/action-scheduler",
				"wp-plugin/posts-to-posts"
			]
		},
		"wp-slug": "orbis-organizations"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis-organizations/",
			"vendor/bin/wp i18n make-pot ./build/orbis-organizations/ --slug=orbis-organizations",
			"vendor/bin/wp i18n make-mo ./build/orbis-organizations/languages/",
			"vendor/bin/wp dist-archive ./build/orbis-organizations/ --plugin-dirname=orbis-organizations --force"
		],
		"deploy": [
			"Composer\\Config::disableProcessTimeout",
			"DEPLOYER_IMPORT=${DEPLOYER_IMPORT:-$HOME/deployer-orbis.php} vendor/bin/dep deploy"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis-organizations",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis-organizations/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis-organizations.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"phpcbf": "vendor/bin/phpcbf",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
		"rector": "vendor/bin/rector process",
		"qa": [
			"@phpcs",
			"@phpstan",
			"vendor/bin/rector process --dry-run"
		]
	},
	"repositories": [{
		"name": "wp-packages",
		"type": "composer",
		"url": "https://repo.wp-packages.org"
	}]
}
